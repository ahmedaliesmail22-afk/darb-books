{
  "name": "darb-books",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "منصة درب للكتب التفاعلية ثلاثية الأبعاد — بنية Monorepo مرنة وقابلة للتمديد",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@darb/web",
    "dev:api": "npm run dev --workspace=@darb/api",
    "dev:api:local": "npm run dev:api:local --workspace=@darb/api",
    "dev:local": "node tools/dev-local.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run typecheck --workspaces && npm run build --workspace=@darb/web",
    "preview": "npm run preview --workspace=@darb/web",
    "test:engine": "npm test --workspace=@darb/book-engine",
    "test:parsers": "npm test --workspace=@darb/parsers",
    "test:api": "npm test --workspace=@darb/api",
    "db:generate": "npm run db:generate --workspace=@darb/api",
    "db:seed": "npm run db:seed --workspace=@darb/api"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
