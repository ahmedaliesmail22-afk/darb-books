# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:4173,http://localhost:4173,capacitor://localhost,http://localhost

# Microsoft SQL Server (استخدم رابط SQL Server المحلي أو Docker)
# مثال محلي عبر منفذ 1433:
DATABASE_URL=sqlserver://127.0.0.1:1433;database=darb_books;user=darb;password=replace-with-strong-sql-password;encrypt=false;trustServerCertificate=true

# Auth & JWT Security (استبدل القيم بأسرار حقيقية في البيئة التشغيلية فقط)
JWT_ACCESS_SECRET=replace-with-strong-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# Bootstrap Seed Super Admin (تُقرأ من البيئة فقط عند تشغيل البذر)
SEED_ADMIN_EMAIL=admin@darb-books.local
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_ADMIN_NAME=مدير منصة درب الأعلى

# Storage (r2 للتخزين السحابي Cloudflare R2 / MinIO، أو local للتطوير بدون سحابة)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=darb-books-media
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BASE_URL=
