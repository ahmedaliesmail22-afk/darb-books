{
  "name": "@darb/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "الخادم الخلفي لمنصة درب للكتب التفاعلية (Fastify + Prisma + PostgreSQL + Dynamic RBAC + R2 Storage)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api:local": "tsx src/local.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@darb/parsers=../../packages/parsers/src/index.ts --alias:@darb/book-schema=../../packages/book-schema/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "prisma generate && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@darb/book-schema": "*",
    "@darb/parsers": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "pg": "^8.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.16.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
