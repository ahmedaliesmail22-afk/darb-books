generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id              String    @id @default(uuid()) @db.NVarChar(64)
  email           String    @unique @db.NVarChar(255)
  passwordHash    String    @map("password_hash") @db.NVarChar(255)
  fullName        String    @map("full_name") @db.NVarChar(200)
  status          String    @default("ACTIVE") @db.NVarChar(40)
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile            UserProfile?
  userRoles          UserRole[]          @relation("UserRoleMember")
  assignedRoles      UserRole[]          @relation("UserRoleAssigner")
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  authoredBooks      Book[]              @relation("BookAuthor")
  reviewTickets      ReviewTicket[]      @relation("TicketReviewer")
  authoredNews       NewsPost[]          @relation("NewsAuthor")
  updatedConfigs     SystemConfig[]      @relation("ConfigUpdater")
  updatedCmsSections CmsSection[]        @relation("CmsSectionUpdater")
  readingProgress    ReadingProgress[]
  auditLogs          AuditLog[]          @relation("AuditActor")

  @@map("users")
}

model UserProfile {
  userId              String   @id @map("user_id") @db.NVarChar(64)
  ageGroupId          String?  @map("age_group_id") @db.NVarChar(64)
  educationLevelId    String?  @map("education_level_id") @db.NVarChar(64)
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  uiPrefsJson         String   @default("{}") @map("ui_prefs_json") @db.NVarChar(Max)
  metadataJson        String   @default("{}") @map("metadata_json") @db.NVarChar(Max)
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ageGroup            Taxonomy?               @relation("UserAgeGroup", fields: [ageGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  educationLevel      Taxonomy?               @relation("UserEducationLevel", fields: [educationLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  preferredTaxonomies UserPreferredTaxonomy[]

  @@map("user_profiles")
}

model UserPreferredTaxonomy {
  userId     String @map("user_id") @db.NVarChar(64)
  taxonomyId String @map("taxonomy_id") @db.NVarChar(64)

  profile  UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  taxonomy Taxonomy    @relation(fields: [taxonomyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, taxonomyId])
  @@map("user_preferred_taxonomies")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.NVarChar(64)
  userId       String    @map("user_id") @db.NVarChar(64)
  tokenHash    String    @unique @map("token_hash") @db.NVarChar(191)
  userAgent    String?   @map("user_agent") @db.NVarChar(500)
  ipAddress    String?   @map("ip_address") @db.NVarChar(120)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.NVarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.NVarChar(64)
  userId    String    @map("user_id") @db.NVarChar(64)
  purpose   String    @db.NVarChar(64)
  tokenHash String    @unique @map("token_hash") @db.NVarChar(191)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model Permission {
  id          String   @id @default(uuid()) @db.NVarChar(64)
  code        String   @unique @db.NVarChar(120)
  module      String   @db.NVarChar(64)
  labelAr     String   @map("label_ar") @db.NVarChar(255)
  labelEn     String?  @map("label_en") @db.NVarChar(255)
  description String?  @db.NVarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.NVarChar(64)
  code        String   @unique @db.NVarChar(120)
  nameAr      String   @map("name_ar") @db.NVarChar(200)
  nameEn      String?  @map("name_en") @db.NVarChar(200)
  description String?  @db.NVarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.NVarChar(64)
  permissionId String @map("permission_id") @db.NVarChar(64)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.NVarChar(64)
  roleId       String   @map("role_id") @db.NVarChar(64)
  assignedById String?  @map("assigned_by_id") @db.NVarChar(64)
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User  @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Taxonomy {
  id          String   @id @default(uuid()) @db.NVarChar(64)
  group       String   @db.NVarChar(64)
  slug        String   @db.NVarChar(120)
  labelAr     String   @map("label_ar") @db.NVarChar(200)
  labelEn     String?  @map("label_en") @db.NVarChar(200)
  description String?  @db.NVarChar(500)
  parentId    String?  @map("parent_id") @db.NVarChar(64)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  rulesJson   String   @default("{}") @map("rules_json") @db.NVarChar(Max)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent              Taxonomy?               @relation("TaxonomyHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children            Taxonomy[]              @relation("TaxonomyHierarchy")
  ageGroupUsers       UserProfile[]           @relation("UserAgeGroup")
  educationLevelUsers UserProfile[]           @relation("UserEducationLevel")
  preferredByUsers    UserPreferredTaxonomy[]
  books               BookTaxonomy[]

  @@unique([group, slug])
  @@index([group, isActive, sortOrder])
  @@map("taxonomies")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.NVarChar(64)
  key         String   @unique @db.NVarChar(120)
  category    String   @db.NVarChar(64)
  valueJson   String   @map("value_json") @db.NVarChar(Max)
  description String?  @db.NVarChar(500)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedById String?  @map("updated_by_id") @db.NVarChar(64)
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category, isPublic])
  @@map("system_configs")
}

model CmsPage {
  id          String   @id @default(uuid()) @db.NVarChar(64)
  slug        String   @unique @db.NVarChar(120)
  titleAr     String   @map("title_ar") @db.NVarChar(255)
  titleEn     String?  @map("title_en") @db.NVarChar(255)
  seoJson     String   @default("{}") @map("seo_json") @db.NVarChar(Max)
  isPublished Boolean  @default(true) @map("is_published")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sections CmsSection[]

  @@map("cms_pages")
}

model CmsSection {
  id          String   @id @default(uuid()) @db.NVarChar(64)
  pageId      String   @map("page_id") @db.NVarChar(64)
  sectionKey  String   @map("section_key") @db.NVarChar(120)
  titleAr     String   @map("title_ar") @db.NVarChar(255)
  titleEn     String?  @map("title_en") @db.NVarChar(255)
  contentJson String   @default("{}") @map("content_json") @db.NVarChar(Max)
  sortOrder   Int      @default(0) @map("sort_order")
  isVisible   Boolean  @default(true) @map("is_visible")
  updatedById String?  @map("updated_by_id") @db.NVarChar(64)
  updatedAt   DateTime @updatedAt @map("updated_at")

  page      CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  updatedBy User?   @relation("CmsSectionUpdater", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([pageId, sectionKey])
  @@index([pageId, isVisible, sortOrder])
  @@map("cms_sections")
}

model NewsPost {
  id          String    @id @default(uuid()) @db.NVarChar(64)
  slug        String    @unique @db.NVarChar(160)
  title       String    @db.NVarChar(255)
  summary     String?   @db.NVarChar(500)
  bodyMd      String    @map("body_md") @db.NVarChar(Max)
  coverUrl    String?   @map("cover_url") @db.NVarChar(500)
  status      String    @default("DRAFT") @db.NVarChar(40)
  publishedAt DateTime? @map("published_at")
  authorId    String?   @map("author_id") @db.NVarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User? @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, publishedAt])
  @@map("news_posts")
}

model Book {
  id              String   @id @default(uuid()) @db.NVarChar(64)
  slug            String   @unique @db.NVarChar(160)
  title           String   @db.NVarChar(255)
  subtitle        String?  @db.NVarChar(350)
  description     String?  @db.NVarChar(Max)
  badge           String?  @db.NVarChar(120)
  badgeColor      String?  @map("badge_color") @db.NVarChar(64)
  theme           String   @default("royal-gold") @db.NVarChar(64)
  direction       String   @default("rtl") @db.NVarChar(16)
  coverUrl        String?  @map("cover_url") @db.NVarChar(500)
  status          String   @default("DRAFT") @db.NVarChar(40)
  activeVersionId String?  @map("active_version_id") @db.NVarChar(64)
  authorId        String?  @map("author_id") @db.NVarChar(64)
  metadataJson    String   @default("{}") @map("metadata_json") @db.NVarChar(Max)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  author          User?             @relation("BookAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions        BookVersion[]     @relation("BookVersions")
  activeVersion   BookVersion?      @relation("BookActiveVersion", fields: [activeVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taxonomies      BookTaxonomy[]
  readingProgress ReadingProgress[]

  @@index([status])
  @@map("books")
}

model BookTaxonomy {
  bookId     String @map("book_id") @db.NVarChar(64)
  taxonomyId String @map("taxonomy_id") @db.NVarChar(64)

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taxonomy Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([bookId, taxonomyId])
  @@map("book_taxonomies")
}

model BookVersion {
  id                  String    @id @default(uuid()) @db.NVarChar(64)
  bookId              String    @map("book_id") @db.NVarChar(64)
  versionNumber       Int       @map("version_number")
  versionLabel        String    @map("version_label") @db.NVarChar(64)
  sourceFormat        String    @default("json") @map("source_format") @db.NVarChar(40)
  sourceFileUrl       String?   @map("source_file_url") @db.NVarChar(500)
  canonicalJsonUrl    String?   @map("canonical_json_url") @db.NVarChar(500)
  canonicalDataJson   String?   @map("canonical_data_json") @db.NVarChar(Max)
  audioDir            String?   @map("audio_dir") @db.NVarChar(500)
  videoDir            String?   @map("video_dir") @db.NVarChar(500)
  chaptersCount       Int       @default(0) @map("chapters_count")
  spreadsCount        Int       @default(0) @map("spreads_count")
  audioTracksCount    Int       @default(0) @map("audio_tracks_count")
  videosCount         Int       @default(0) @map("videos_count")
  ipDeclarationSigned Boolean   @default(false) @map("ip_declaration_signed")
  status              String    @default("DRAFT") @db.NVarChar(40)
  submittedAt         DateTime? @map("submitted_at")
  publishedAt         DateTime? @map("published_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  book           Book           @relation("BookVersions", fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activeForBooks Book[]         @relation("BookActiveVersion")
  reviewTickets  ReviewTicket[]
  mediaAssets    MediaAsset[]

  @@unique([bookId, versionNumber])
  @@index([bookId, status])
  @@map("book_versions")
}

model ReviewTicket {
  id              String   @id @default(uuid()) @db.NVarChar(64)
  bookVersionId   String   @map("book_version_id") @db.NVarChar(64)
  reviewerId      String?  @map("reviewer_id") @db.NVarChar(64)
  checklistJson   String   @default("{}") @map("checklist_json") @db.NVarChar(Max)
  contentVerified Boolean  @default(false) @map("content_verified")
  ipVerified      Boolean  @default(false) @map("ip_verified")
  decision        String?  @db.NVarChar(64)
  notes           String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bookVersion BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer    User?       @relation("TicketReviewer", fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bookVersionId])
  @@map("review_tickets")
}

model MediaAsset {
  id             String   @id @default(uuid()) @db.NVarChar(64)
  bookVersionId  String   @map("book_version_id") @db.NVarChar(64)
  assetType      String   @map("asset_type") @db.NVarChar(40)
  r2Key          String   @unique @map("r2_key") @db.NVarChar(255)
  mimeType       String   @map("mime_type") @db.NVarChar(120)
  sizeBytes      Int      @map("size_bytes")
  checksumSha256 String?  @map("checksum_sha256") @db.NVarChar(128)
  metadataJson   String   @default("{}") @map("metadata_json") @db.NVarChar(Max)
  createdAt      DateTime @default(now()) @map("created_at")

  bookVersion BookVersion @relation(fields: [bookVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bookVersionId, assetType])
  @@map("media_assets")
}

model ReadingProgress {
  id            String   @id @default(uuid()) @db.NVarChar(64)
  userId        String   @map("user_id") @db.NVarChar(64)
  bookId        String   @map("book_id") @db.NVarChar(64)
  currentSpread Int      @default(0) @map("current_spread")
  percent       Float    @default(0)
  bookmarksJson String   @default("[]") @map("bookmarks_json") @db.NVarChar(Max)
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, bookId])
  @@map("reading_progress")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.NVarChar(64)
  actorId      String?  @map("actor_id") @db.NVarChar(64)
  action       String   @db.NVarChar(120)
  targetType   String   @map("target_type") @db.NVarChar(80)
  targetId     String   @map("target_id") @db.NVarChar(160)
  metadataJson String   @default("{}") @map("metadata_json") @db.NVarChar(Max)
  ipAddress    String?  @map("ip_address") @db.NVarChar(120)
  userAgent    String?  @map("user_agent") @db.NVarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
